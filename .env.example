# =============================================================================
# Template environment variable untuk Sistem Deteksi Intrusi Kolaboratif
# Salin file ini menjadi .env dan sesuaikan nilainya
# =============================================================================

# Konfigurasi Database TimescaleDB
DB_HOST=timescaledb
DB_PORT=5432
DB_NAME=ids_thesis
DB_USER=ids_user
DB_PASSWORD=ids_password

# Konfigurasi Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Port Penerima Syslog UDP
SYSLOG_UDP_PORT=514

# Konfigurasi Web Server Golang
WEB_PORT=8080
# Alamat bind port dashboard di host. Bawaan 0.0.0.0 (terbuka, akses via
# http://IP:8080). Untuk production di belakang reverse proxy (Caddy/nginx
# + Cloudflare), set ke 127.0.0.1 agar hanya proxy yang bisa mengaksesnya.
WEB_BIND=0.0.0.0
SESSION_SECRET=ganti_dengan_secret_key_yang_kuat_minimal_32_karakter

# Konfigurasi Default MikroTik API
MIKROTIK_DEFAULT_API_PORT=8728
MIKROTIK_DEFAULT_USERNAME=admin
MIKROTIK_DEFAULT_PASSWORD=admin

# Parameter Model Isolation Forest
IF_N_ESTIMATORS=100
IF_CONTAMINATION=0.1
IF_MAX_SAMPLES=256

# Jendela waktu data historis untuk analisis (dalam menit)
ANALYSIS_WINDOW_MINUTES=10

# Ambang klasifikasi dan aksi blokir otomatis.
# Nilai berikut adalah hasil tuning evaluasi kuantitatif (make evaluate):
# ANOMALY_THRESHOLD=0.0 mengikuti batas alami decision_function scikit-learn
# (skor negatif = anomali, sesuai kalibrasi contamination).
# Ambang juga dapat diubah saat runtime dari web UI (menu Decision Engine).
ANOMALY_THRESHOLD=0.0
BLOCK_SCORE_THRESHOLD=-0.05
BLOCK_CONFIDENCE_THRESHOLD=0.60
# Jumlah record minimum agar faktor kecukupan data pada keyakinan bernilai penuh
CONFIDENCE_FULL_SAMPLES=10

# Interval retraining model (dalam jumlah syslog baru)
MODEL_RETRAIN_INTERVAL=100

# Konfigurasi Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123
