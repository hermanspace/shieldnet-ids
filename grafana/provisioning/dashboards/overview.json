      "id": 6,
      "options": { "tooltip": { "mode": "single" } },
      "title": "Jumlah Intrusi Per Jam (7 Hari Terakhir)",
      "type": "timeseries",
      "targets": [{
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescaledb-ids" },
        "rawSql": "SELECT time_bucket('1 hour', time) AS time, COUNT(*) AS \"Intrusi\" FROM intrusion_results WHERE is_intrusion = true AND $__timeFilter(time) GROUP BY 1 ORDER BY 1",
        "format": "time_series",
        "refId": "A"
      }]
    },
    {
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescaledb-ids" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 7,
      "options": { "orientation": "horizontal" },
      "title": "Top 10 IP Sumber Paling Banyak Terdeteksi",
      "type": "barchart",
      "targets": [{
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescaledb-ids" },
        "rawSql": "SELECT source_ip AS \"IP\", COUNT(*) AS \"Jumlah\" FROM intrusion_results WHERE is_intrusion = true AND time > NOW() - INTERVAL '24 hours' GROUP BY source_ip ORDER BY COUNT(*) DESC LIMIT 10",
        "format": "table",
        "refId": "A"
      }]
    },
    {
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescaledb-ids" },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {"matcher": {"id": "byName", "options": "is_intrusion"}, "properties": [{"id": "custom.displayMode", "value": "color-background"}, {"id": "thresholds", "value": {"steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}]}
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 8,
      "options": { "sortBy": [{"displayName": "time", "desc": true}] },
      "title": "Daftar Intrusi Terbaru",
      "type": "table",
      "targets": [{
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescaledb-ids" },
        "rawSql": "SELECT time, source_ip, anomaly_score, confidence, action_taken, distributed FROM intrusion_results WHERE is_intrusion = true ORDER BY time DESC LIMIT 50",
        "format": "table",
        "refId": "A"
      }]
    }
