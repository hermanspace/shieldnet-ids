        "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescaledb-ids" },
        "rawSql": "SELECT COUNT(*) AS \"Total Syslog\" FROM syslogs WHERE time > NOW() - INTERVAL '24 hours'",
