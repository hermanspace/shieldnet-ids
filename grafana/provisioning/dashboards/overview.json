      "targets": [{
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescaledb-ids" },
        "rawSql": "SELECT time_bucket('1 hour', time) AS time, COUNT(*) AS \"Syslog\" FROM syslogs WHERE $__timeFilter(time) GROUP BY 1 ORDER BY 1",
        "format": "time_series",
        "refId": "A"
      }]
    },
    {
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescaledb-ids" },
