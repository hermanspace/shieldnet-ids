        "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescaledb-ids" },
        "rawSql": "SELECT COUNT(DISTINCT source_ip) AS \"IP Unik\" FROM intrusion_results WHERE time > NOW() - INTERVAL '24 hours' AND is_intrusion = true",
        "format": "table",
        "refId": "A"
