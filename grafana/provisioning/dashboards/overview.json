      "targets": [{
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescaledb-ids" },
        "rawSql": "SELECT COUNT(*) AS \"Intrusi\" FROM intrusion_results WHERE time > NOW() - INTERVAL '24 hours' AND is_intrusion = true",
