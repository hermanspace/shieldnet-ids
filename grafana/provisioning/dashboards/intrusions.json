{
  "__inputs": [],
  "__requires": [],
  "annotations": { "list": [] },
  "description": "Dashboard detail deteksi intrusi dan distribusi skor anomali",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescaledb-ids" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "unit": "percentunit",
          "thresholds": { "mode": "absolute", "steps": [{"color": "red","value": null}, {"color": "yellow","value": 0.5}, {"color": "green","value": 0.8}] }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Persentase Deteksi Intrusi",
      "type": "stat",
      "targets": [{
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescaledb-ids" },
        "rawSql": "SELECT CASE WHEN COUNT(*) > 0 THEN CAST(SUM(CASE WHEN is_intrusion THEN 1 ELSE 0 END) AS FLOAT) / COUNT(*) ELSE 0 END AS \"Rasio\" FROM intrusion_results WHERE time > NOW() - INTERVAL '24 hours'",
        "format": "table",
        "refId": "A"
      }]
    },
    {
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescaledb-ids" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "decimals": 4,
          "thresholds": { "mode": "absolute", "steps": [{"color": "red","value": null}, {"color": "yellow","value": -0.2}, {"color": "green","value": 0}] }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["mean"] } },
      "title": "Rata-rata Skor Anomali",
      "type": "stat",
      "targets": [{
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescaledb-ids" },
        "rawSql": "SELECT AVG(anomaly_score) AS \"Rata-rata Skor\" FROM intrusion_results WHERE time > NOW() - INTERVAL '24 hours'",
        "format": "table",
        "refId": "A"
      }]
    },
    {
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescaledb-ids" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } } },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": { "displayLabels": ["percent"], "pieType": "donut" },
      "title": "Distribusi Aksi Diambil",
      "type": "piechart",
      "targets": [{
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescaledb-ids" },
        "rawSql": "SELECT action_taken AS \"Aksi\", COUNT(*) AS \"Jumlah\" FROM intrusion_results WHERE time > NOW() - INTERVAL '24 hours' GROUP BY action_taken",
        "format": "table",
        "refId": "A"
      }]
    },
    {
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescaledb-ids" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{"color": "blue","value": null}] }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Total Analisis (24 Jam)",
      "type": "stat",
      "targets": [{
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescaledb-ids" },
        "rawSql": "SELECT COUNT(*) AS \"Total Analisis\" FROM intrusion_results WHERE time > NOW() - INTERVAL '24 hours'",
        "format": "table",
        "refId": "A"
      }]
    },
    {
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescaledb-ids" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "continuous-RdYlGr" }, "custom": { "lineWidth": 2 } }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "options": { "tooltip": { "mode": "single" } },
      "title": "Rata-rata Skor Anomali Per Jam",
      "type": "timeseries",
      "targets": [{
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescaledb-ids" },
        "rawSql": "SELECT time_bucket('1 hour', time) AS time, AVG(anomaly_score) AS \"Skor Rata-rata\" FROM intrusion_results WHERE $__timeFilter(time) GROUP BY 1 ORDER BY 1",
        "format": "time_series",
        "refId": "A"
      }]
    },
    {
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescaledb-ids" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "options": { "orientation": "horizontal", "fillOpacity": 80 },
      "title": "Distribusi Aksi Per Jam",
      "type": "barchart",
      "targets": [{
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescaledb-ids" },
        "rawSql": "SELECT time_bucket('1 hour', time) AS time, COUNT(CASE WHEN action_taken='block' THEN 1 END) AS \"Blokir\", COUNT(CASE WHEN action_taken='monitor' THEN 1 END) AS \"Monitor\", COUNT(CASE WHEN action_taken='allow' THEN 1 END) AS \"Izinkan\" FROM intrusion_results WHERE $__timeFilter(time) GROUP BY 1 ORDER BY 1",
        "format": "table",
        "refId": "A"
      }]
    },
    {
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescaledb-ids" },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {"matcher": {"id": "byName", "options": "anomaly_score"}, "properties": [{"id": "custom.displayMode", "value": "color-background"}, {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "red","value": null}, {"color": "yellow","value": -0.2}, {"color": "green","value": 0}]}}]},
          {"matcher": {"id": "byName", "options": "confidence"}, "properties": [{"id": "unit", "value": "percentunit"}]}
        ]
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 12 },
      "id": 7,
      "options": { "sortBy": [{"displayName": "time", "desc": true}] },
      "title": "Semua Hasil Deteksi Intrusi",
      "type": "table",
      "targets": [{
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "timescaledb-ids" },
        "rawSql": "SELECT time, source_ip, anomaly_score, confidence, action_taken, distributed FROM intrusion_results WHERE is_intrusion = true AND $__timeFilter(time) ORDER BY time DESC LIMIT 200",
        "format": "table",
        "refId": "A"
      }]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["IDS", "intrusions"],
  "templating": { "list": [] },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "Asia/Jakarta",
  "title": "IDS - Detail Intrusi",
  "uid": "ids-intrusions",
  "version": 1
}
